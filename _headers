# ================================================================
# _headers - رؤوس الأمان والأداء - نجوم دلتا للتجارة
# ================================================================

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(self "https://cdn.moyasar.com"), usb=(), interest-cohort=()
  X-DNS-Prefetch-Control: off
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.moyasar.com https://www.googletagmanager.com https://cdn.jsdelivr.net https://*.googleapis.com https://*.firebaseio.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.moyasar.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https: http:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.firebaseio.com wss://*.firebaseio.com https://*.googleapis.com https://*.google.com https://api.moyasar.com https://cdn.moyasar.com https://api.authentica.sa https://generativelanguage.googleapis.com https://lh3.googleusercontent.com https://deltastars.store https://deltastars-ksa.com; frame-src https://cdn.moyasar.com https://www.google.com https://*.firebaseapp.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://api.moyasar.com; upgrade-insecure-requests;

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-store, no-cache, must-revalidate
  Pragma: no-cache
  Expires: 0

/manifest.json
  Cache-Control: no-cache
  Content-Type: application/manifest+json

/service-worker.js
  Cache-Control: no-store
  Service-Worker-Allowed: /

/robots.txt
  Cache-Control: public, max-age=86400

/.env
  X-Robots-Tag: noindex, nofollow
