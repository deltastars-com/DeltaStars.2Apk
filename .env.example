# ==============================================================================
# Delta Stars Trading - Production Environment Template (.env.example)
# ==============================================================================
#
# INSTRUCTIONS:
# Copy this file to '.env' or '.env.production' and fill in your actual live credentials.
# WARNING: NEVER commit your actual '.env' or secret keys to any Git repository or public host!
# All sensitive variables should be set strictly inside your Hosting Panel (Netlify/Vercel)
# and Codemagic CI/CD environment variables to prevent leakage.
#

# ------------------------------------------------------------------------------
# 1. Supabase sovereign database configuration (Public Client Access)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ------------------------------------------------------------------------------
# 2. AI Assistant (Gemini) Credentials (Public Client Access / Server Proxy)
# ------------------------------------------------------------------------------
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# ------------------------------------------------------------------------------
# 3. Google Maps API (Public client-side map rendering)
# ------------------------------------------------------------------------------
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
GOOGLE_MAPS_PLATFORM_KEY=your-google-maps-platform-api-key-here

# ------------------------------------------------------------------------------
# 4. Moyasar Payment Gateway (Public Publishing Key)
# ------------------------------------------------------------------------------
VITE_MOYASAR_PUBLISHABLE_KEY=pk_live_your-publishable-key-here

# ------------------------------------------------------------------------------
# 5. Firebase PWA & Push Notification SDK Config
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_VAPID_KEY=your-firebase-cloud-messaging-vapid-key-here

# ------------------------------------------------------------------------------
# 6. Global Store Configurations
# ------------------------------------------------------------------------------
VITE_APP_VERSION=1.0.0
VITE_APP_URL=https://deltastars.store

# ------------------------------------------------------------------------------
# 7. Backend Sovereign Secrets (Server-Side ONLY - Do NOT use VITE_ prefix!)
#    These are configured exclusively in Netlify Functions Env Settings
# ------------------------------------------------------------------------------
AUTHENTICA_API_KEY=your-sms-gateway-key
AUTHENTICA_API_SECRET=your-sms-gateway-secret
MOYASAR_SECRET_KEY=sk_live_your-moyasar-secret-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-for-webhooks

# ── Optional / advanced integrations (used by a few auxiliary components) ──
# GitHub integration (src/lib/github.ts) — only needed if you wire up the
# developer-console "push to GitHub" feature.
VITE_GITHUB_TOKEN=your-github-personal-access-token

# ONYX ERP bridge (src/services/onyxService.ts) — only needed if you connect
# an external ONYX ERP instance for accounting sync.
VITE_ONYX_API_URL=https://erp.deltastars.sa/api/v1
VITE_ONYX_API_KEY=your-onyx-api-key
VITE_ONYX_SECRET_KEY=your-onyx-secret-key
